# Copie para .env e preencha. Nunca commite o .env.
# Senhas e tokens internos: qualquer valor aleatório (openssl rand -hex 32).

# ================================================================ base
POSTGRES_USER=studio
POSTGRES_PASSWORD=troque-esta-senha
# token que o n8n usa para chamar os módulos (Authorization: Bearer ...)
WORKER_TOKEN=troque-por-um-token-aleatorio
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria
# token interno n8n → bot
BOT_API_TOKEN=troque-por-um-token-aleatorio
# fuso dos agendamentos e logs (formato <região>/<cidade>)
TZ=UTC

# ================================================================ Discord
# Developer Portal → sua aplicação → Bot → Reset Token (ligue também o "Message Content Intent")
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=<id-do-canal>
# quem pode usar o studio (IDs separados por vírgula). Vazio = qualquer um do canal
DISCORD_ALLOWED_USER_IDS=
# módulo que recebe as mensagens com link no canal
STUDIO_DEFAULT_MODULE=cortes

# ================================================================ IA (todos os módulos)
# anthropic = Claude API | claude_code = assinatura do Claude pelo CLI (testes)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
LLM_MODEL=claude-opus-5-5

# ================================================================ módulo cortes
WORKER_CONCURRENCY=1
CONTENT_LANGUAGE=pt-BR
# transcrição local, só quando o YouTube não tem legenda
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
CUT_MAX_DURATION_S=75
# auto (vertical→crop, horizontal→fit_blur) | crop | fit_blur | split
CUT_LAYOUT=auto
# cookies do navegador (formato Netscape) se o YouTube pedir login; caminho dentro do container
YOUTUBE_COOKIES_FILE=
