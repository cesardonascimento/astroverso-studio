{
  "_doc": "Presets editáveis sem código. O worker relê este arquivo a cada renderização. Cores no formato #RRGGBB.",
  "defaults": {
    "subtitle_preset": "padrao",
    "layout": "auto",
    "max_duration_s": 75
  },
  "subtitles": {
    "padrao": {
      "description": "Montserrat bold branca, palavra atual em amarelo, 3 palavras por vez",
      "font": "Montserrat", "size": 88, "bold": true, "uppercase": true,
      "color": "#FFFFFF", "highlight": "#FFE500", "outline_color": "#000000",
      "outline": 7, "shadow": 3, "max_words": 3, "max_chars": 18
    },
    "grande": {
      "description": "igual ao padrão, maior e com 2 palavras por vez",
      "font": "Montserrat", "size": 108, "bold": true, "uppercase": true,
      "color": "#FFFFFF", "highlight": "#FFE500", "outline_color": "#000000",
      "outline": 8, "shadow": 3, "max_words": 2, "max_chars": 14
    },
    "verde": {
      "description": "destaque verde-limão",
      "font": "Montserrat", "size": 92, "bold": true, "uppercase": true,
      "color": "#FFFFFF", "highlight": "#7CFF3A", "outline_color": "#000000",
      "outline": 7, "shadow": 3, "max_words": 3, "max_chars": 18
    },
    "minimalista": {
      "description": "frases mais longas, sem destaque, minúsculas, contorno fino",
      "font": "Montserrat", "size": 70, "bold": true, "uppercase": false,
      "color": "#FFFFFF", "highlight": "#FFFFFF", "outline_color": "#000000",
      "outline": 4, "shadow": 2, "max_words": 6, "max_chars": 32
    }
  }
}
