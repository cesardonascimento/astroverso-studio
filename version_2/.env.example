# Copie para .env e preencha. NUNCA commite o .env.
POSTGRES_USER=cuts
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cuts

# token para chamar o worker (Authorization: Bearer ...). gere com: openssl rand -hex 32
WORKER_TOKEN=troque-por-um-token-aleatorio
WORKER_CONCURRENCY=1
CONTENT_LANGUAGE=pt-BR

# --- LLM ---
# claude_code = CLI do Claude Code com sua ASSINATURA | anthropic = Claude API
LLM_PROVIDER=claude_code
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Transcrição local (só quando o YouTube não tem legenda) ---
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# --- Cortes ---
CUT_MAX_DURATION_S=75
# auto (vertical→crop, horizontal→fit_blur) | crop | fit_blur
CUT_LAYOUT=auto
# opcional: cookies do navegador (formato Netscape) se o YouTube pedir login. Caminho dentro do container.
YOUTUBE_COOKIES_FILE=

# --- n8n ---
# gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria
# o worker avisa o n8n a cada mudança de estado
N8N_EVENTS_URL=http://n8n:5678/webhook/job-events

# --- Discord ---
# Developer Portal → sua aplicação → Bot → Reset Token (ligue também o "Message Content Intent")
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=<id-do-servidor>
DISCORD_CHANNEL_ID=<id-do-canal>
# opcional: só estes usuários podem pedir cortes (IDs separados por vírgula). Vazio = qualquer um do canal
DISCORD_ALLOWED_USER_IDS=
# token interno n8n → bot. gere com: openssl rand -hex 32
BOT_API_TOKEN=troque-por-um-token-aleatorio

# fuso dos agendamentos e logs do n8n (formato <região>/<cidade>)
TZ=UTC
