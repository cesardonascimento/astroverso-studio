# Copie para .env e preencha. NUNCA commite o .env.

# --- Banco ---
POSTGRES_USER=content
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=content

# --- n8n ---
# gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# --- Worker ---
# token que o n8n usa para chamar o worker (Authorization: Bearer ...)
# gere com: openssl rand -hex 32
WORKER_TOKEN=troque-por-um-token-aleatorio
WORKER_CONCURRENCY=1
CONTENT_LANGUAGE=pt-BR
TREND_COUNTRY=BR

# --- LLM ---
# claude_code = CLI do Claude Code usando sua ASSINATURA (validação; consome os limites do plano)
# anthropic   = Claude API (console.anthropic.com, cobrança por uso; usar em produção)
LLM_PROVIDER=claude_code
# gere com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# modelo para tarefas simples (revisão/QC de texto). Opções mais baratas: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL_FAST=claude-opus-5-5
# liga a busca na web do Claude para entender hashtags desconhecidas (custa ~US$0,01 por busca)
LLM_TREND_WEB_SEARCH=true

# --- Tendências ---
# apify = Creative Center do TikTok via scraper no Apify (não oficial)
# manual = lê config/manual_trends.json
TREND_PROVIDER=manual
APIFY_TOKEN=
APIFY_TREND_ACTOR=data_xplorer~tiktok-trends

# --- Voz ---
# edge = vozes neurais da Microsoft via edge-tts (grátis, NÃO oficial — bom para validar)
TTS_PROVIDER=edge
TTS_VOICE=pt-BR-AntonioNeural
TTS_RATE=+12%

# --- Imagens ---
# placeholder = cartões gerados localmente (só para testar o pipeline)
# pexels = fotos de banco de imagens grátis (API oficial, precisa de chave grátis)
IMAGE_PROVIDER=placeholder
PEXELS_API_KEY=
